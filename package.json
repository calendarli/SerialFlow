{
  "name": "serialflow",
  "productName": "SerialFlow",
  "desktopName": "io.github.calendarli.serialflow.desktop",
  "version": "3.6.3",
  "description": "高速串口数据调试与自动化交互工具",
  "main": "./out/main/index.js",
  "author": "calendarli",
  "license": "GPL-3.0-only",
  "scripts": {
    "release:version": "bun scripts/release-version.ts",
    "release:notes": "bun scripts/release-notes.ts",
    "package:win-x64": "bun run build && electron-builder --win nsis --x64 --publish never",
    "package:linux-x64": "bun run build && electron-builder --linux AppImage deb --x64 --publish never",
    "package:linux-arm64": "bun run build && electron-builder --linux AppImage deb --arm64 --publish never",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:tools",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "bun scripts/postinstall.ts",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "test": "bun test",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "format:check": "prettier --check .",
    "build:driver": "bun scripts/build-driver.ts",
    "fetch:esptool": "bun scripts/fetch-esptool.ts",
    "test:ui": "bun scripts/run-ui-smoke.ts",
    "test:ui:updates": "bun scripts/run-ui-smoke.ts updates",
    "test:ui:serial": "bun scripts/run-ui-smoke.ts serial",
    "test:ui:plot": "bun scripts/run-ui-smoke.ts plot"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "extract-zip": "^2.0.1",
    "jiti": "^2.7.0",
    "lucide-react": "^1.45.0",
    "prettier": "^3.9.6",
    "quickjs-emscripten": "^0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "contributors": [
    "calendarli",
    "kairlec"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/calendarli/SerialFlow.git"
  },
  "homepage": "https://github.com/calendarli/SerialFlow",
  "bugs": {
    "url": "https://github.com/calendarli/SerialFlow/issues"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
